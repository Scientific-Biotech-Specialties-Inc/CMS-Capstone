server {
    listen ${CMS_WEB_PORT};
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 25m;
    resolver ${RESOLVER} valid=10s ipv6=off;

    # Static Vue 3 SPA assets
    location /cms/ {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ /cms/index.html;
    }

    location = / {
        return 302 /cms/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Microservice reverse proxies (rewrites /api/<service>/* -> /api/* on backend)
    location = /api/vendor { return 302 /api/vendor/; }
    location /api/vendor/ {
        set $upstream_vendor "vendor-management${INTERNAL_DOMAIN}";
        rewrite ^/api/vendor/up$ /up break;
        rewrite ^/api/vendor/(.*)$ /api/$1 break;
        proxy_pass http://$upstream_vendor:80;
        proxy_http_version 1.1;
        proxy_set_header Host $upstream_vendor;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Cookie;
        proxy_read_timeout 180s;
    }

    location = /api/contract { return 302 /api/contract/; }
    location /api/contract/ {
        set $upstream_contract "contract-management${INTERNAL_DOMAIN}";
        rewrite ^/api/contract/up$ /up break;
